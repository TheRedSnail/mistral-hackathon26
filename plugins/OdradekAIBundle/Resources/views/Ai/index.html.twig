<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Odradek AI — Mautic</title>
    <link rel="stylesheet" href="{{ assetBase }}/css/odradek-ai.css">
</head>
<body>
<div id="odradek-split">

    <!-- ── Top pane: Mautic iframe ── -->
    <div id="odradek-mautic-pane">
        <div id="odradek-iframe-toolbar">

            <!-- ── Odradek brand logo ── -->
            <div id="odradek-brand" title="Odradek AI — Autonomous Mautic Intelligence">
                <svg class="odradek-logo-svg" width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Outer dashed orbit ring (Kafka's thread) -->
                    <circle cx="16" cy="16" r="14" stroke="#1f6feb" stroke-width="0.75" stroke-dasharray="2.5 2" opacity="0.35"/>
                    <!-- Mid ring -->
                    <circle cx="16" cy="16" r="9" stroke="#1f6feb" stroke-width="0.5" opacity="0.2"/>
                    <!-- 8 arms (star-shaped spool) -->
                    <line x1="16" y1="2"    x2="16" y2="30"   stroke="#388bfd" stroke-width="1.1" stroke-linecap="round" opacity="0.75"/>
                    <line x1="2"  y1="16"   x2="30" y2="16"   stroke="#388bfd" stroke-width="1.1" stroke-linecap="round" opacity="0.75"/>
                    <line x1="4.69" y1="4.69" x2="27.31" y2="27.31" stroke="#58a6ff" stroke-width="1.1" stroke-linecap="round" opacity="0.6"/>
                    <line x1="27.31" y1="4.69" x2="4.69" y2="27.31" stroke="#58a6ff" stroke-width="1.1" stroke-linecap="round" opacity="0.6"/>
                    <!-- Center ring + glow -->
                    <circle cx="16" cy="16" r="5"   fill="#0d1117" stroke="#58a6ff" stroke-width="1.4"/>
                    <circle cx="16" cy="16" r="2.5" fill="#58a6ff" class="odradek-core-pulse"/>
                    <circle cx="16" cy="16" r="1"   fill="#c9d1d9"/>
                    <!-- Cardinal tip nodes -->
                    <circle cx="16"    cy="2"     r="1.8" fill="#1f6feb"/>
                    <circle cx="16"    cy="30"    r="1.8" fill="#1f6feb"/>
                    <circle cx="2"     cy="16"    r="1.8" fill="#1f6feb"/>
                    <circle cx="30"    cy="16"    r="1.8" fill="#1f6feb"/>
                    <!-- Diagonal tip nodes -->
                    <circle cx="4.69"  cy="4.69"  r="1.5" fill="#388bfd"/>
                    <circle cx="27.31" cy="27.31" r="1.5" fill="#388bfd"/>
                    <circle cx="27.31" cy="4.69"  r="1.5" fill="#388bfd"/>
                    <circle cx="4.69"  cy="27.31" r="1.5" fill="#388bfd"/>
                </svg>
                <div id="odradek-brand-text">
                    <span id="odradek-brand-name">ODRADEK</span>
                    <span id="odradek-brand-sub">AI</span>
                </div>
            </div>

            <div id="odradek-brand-divider"></div>
            <button id="odradek-back" title="Back">&#8592;</button>
            <button id="odradek-forward" title="Forward">&#8594;</button>
            <span id="odradek-url-display"></span>
            <div id="odradek-toolbar-actions">
                <button id="odradek-select-btn" title="Click to select an element and send it as AI context">&#8853; Select</button>
                <button id="odradek-capture-btn" title="Send current page context to AI">&#128203; Context</button>
            </div>
        </div>
        <iframe
            id="odradek-mautic-frame"
            src="/s/dashboard"
            sandbox="allow-same-origin allow-scripts allow-forms allow-popups allow-modals"
        ></iframe>
    </div>

    <!-- ── Drag divider ── -->
    <div id="odradek-divider" title="Drag to resize"></div>

    <!-- ── Bottom pane: AI chat ── -->
    <div id="odradek-ai-pane">
        <div id="odradek-header">
            <span class="odradek-logo">
                <svg width="16" height="16" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="16" cy="16" r="14" stroke="#1f6feb" stroke-width="0.75" stroke-dasharray="2.5 2" opacity="0.4"/>
                    <line x1="16" y1="2"    x2="16" y2="30"   stroke="#388bfd" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
                    <line x1="2"  y1="16"   x2="30" y2="16"   stroke="#388bfd" stroke-width="1.2" stroke-linecap="round" opacity="0.8"/>
                    <line x1="4.69" y1="4.69" x2="27.31" y2="27.31" stroke="#58a6ff" stroke-width="1.2" stroke-linecap="round" opacity="0.65"/>
                    <line x1="27.31" y1="4.69" x2="4.69" y2="27.31" stroke="#58a6ff" stroke-width="1.2" stroke-linecap="round" opacity="0.65"/>
                    <circle cx="16" cy="16" r="5" fill="#0d1117" stroke="#58a6ff" stroke-width="1.5"/>
                    <circle cx="16" cy="16" r="2.5" fill="#58a6ff"/>
                    <circle cx="16" cy="16" r="1"   fill="#c9d1d9"/>
                    <circle cx="16" cy="2"  r="1.8" fill="#1f6feb"/>
                    <circle cx="16" cy="30" r="1.8" fill="#1f6feb"/>
                    <circle cx="2"  cy="16" r="1.8" fill="#1f6feb"/>
                    <circle cx="30" cy="16" r="1.8" fill="#1f6feb"/>
                    <circle cx="4.69"  cy="4.69"  r="1.4" fill="#388bfd"/>
                    <circle cx="27.31" cy="27.31" r="1.4" fill="#388bfd"/>
                    <circle cx="27.31" cy="4.69"  r="1.4" fill="#388bfd"/>
                    <circle cx="4.69"  cy="27.31" r="1.4" fill="#388bfd"/>
                </svg>
                Odradek AI
            </span>
            <span id="odradek-model-badge">{{ model|default('mistral-large-latest') }}</span>
            <label class="odradek-toggle" title="Plan mode: preview steps before execution">
                <input type="checkbox" id="odradek-plan-mode">
                <span>Plan Mode</span>
            </label>
            <button id="odradek-clear" title="Clear conversation history">&#10005; Clear</button>
            <button id="odradek-minimize" title="Minimize AI panel">&#8964;</button>
        </div>

        <div id="odradek-messages"></div>

        <div id="odradek-input-area">
            <div id="odradek-context-chips"></div>
            <div id="odradek-quick-actions">
                <button class="quick-action-btn" data-action="ethics"      title="Analyze an email for dark patterns and EU AI Act compliance">🛡 Ethics Check</button>
                <button class="quick-action-btn" data-action="performance" title="Get AI-powered insights on a campaign's results">📊 Campaign Insights</button>
                <button class="quick-action-btn" data-action="journey"     title="Generate a structured email journey plan from a goal">🗺 Plan Journey</button>
                <button class="quick-action-btn" data-action="compliance"  title="Run an EU AI Act + GDPR compliance audit on a campaign">📋 Compliance Audit</button>
                <button class="quick-action-btn" data-action="sentiment"   title="Analyze a contact's sentiment and engagement signals">💬 Contact Sentiment</button>
                <button class="quick-action-btn" data-action="health"      title="Score a contact's engagement health and churn risk">❤️ Health Score</button>
            </div>

            <!-- ── Inline action drawer (replaces window.prompt popups) ── -->
            <div id="odradek-action-drawer" hidden>
                <div id="odradek-action-drawer-top">
                    <span id="odradek-action-drawer-title">
                        <span id="odradek-action-drawer-icon"></span>
                        <span id="odradek-action-drawer-label"></span>
                    </span>
                    <button id="odradek-action-cancel" type="button">&#10005; Cancel</button>
                </div>
                <p id="odradek-action-drawer-hint"></p>
                <div id="odradek-action-drawer-row">
                    <input type="text" id="odradek-action-input" autocomplete="off" spellcheck="false" />
                    <button id="odradek-action-run" type="button">Run &#8629;</button>
                </div>
            </div>

            <textarea
                id="odradek-input"
                placeholder="Ask the AI to do anything in Mautic… (Enter to send, Shift+Enter for newline)"
                rows="3"
                spellcheck="true"
            ></textarea>
            <div id="odradek-input-actions">
                <span id="odradek-status"></span>
                <button id="odradek-send">Send &#8629;</button>
            </div>
        </div>
    </div>

</div>

<script>
    window.ODRADEK_CHAT_URL = {{ chatUrl|json_encode|raw }};
</script>
<script src="{{ assetBase }}/js/odradek-ai.js"></script>
</body>
</html>
